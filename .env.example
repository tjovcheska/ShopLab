# Copy this file to `.env` and adjust as needed:  cp .env.example .env

# --- Database -------------------------------------------------------------
# SQLite file used by Prisma. Relative paths resolve from the project root.
DATABASE_URL="file:./dev.db"

# --- Sessions -------------------------------------------------------------
# Secret used to sign the session cookie. Use a long random string outside
# local development, e.g. `openssl rand -hex 32`.
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Chaos / flakiness defaults --------------------------------------------
# Default delay (ms) added to every API response. 0 = off. Max 15000.
# Can be overridden per request with ?delay=<ms> or the shoplab_delay cookie.
CHAOS_DELAY_MS=0

# Default percentage (0-100) of API requests that fail with HTTP 500.
# Can be overridden with the shoplab_flaky cookie.
CHAOS_FLAKY_PERCENT=0

# --- Test support endpoints ------------------------------------------------
# When "true", the /api/test/* endpoints are enabled: health, reset,
# users, products, login-as (see README). Otherwise they all return 404.
# Keep "false" anywhere students should not be able to reset data.
TEST_HOOKS_ENABLED=false
